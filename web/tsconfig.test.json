{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "resolveJsonModule": true,
    "incremental": true,
    "jsx": "react-jsx"
  },
  "include": [
    "test/**/*.ts",
    "test/**/*.tsx",
    "test/**/*.mts",
    "test/**/*.js",
    "test/**/*.mjs",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
